{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Codex Runway main window and tray",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    "http:default",
    "os:default",
    "shell:default"
  ]
}
